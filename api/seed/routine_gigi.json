{
  "$comment": "Seed del perfil 2. Extiende seed-rutina.json con ejercicios nuevos y su rutina. Cargar DESPUES del principal.",
  "extends": "seed-rutina.json",
  "patterns_add": [
    "abduccion"
  ],
  "exercises": [
    {
      "id": "abductora-maquina",
      "name": "Abductora en máquina",
      "pattern": "abduccion",
      "equipment": "maquina",
      "default_rest_s": 60,
      "description": "Sentada en la máquina, separas las rodillas contra la resistencia. Con el tronco inclinado hacia delante trabaja mucho más el glúteo medio, que es el que da forma redondeada a la parte alta y lateral. Erguida trabaja bastante menos."
    },
    {
      "id": "abduccion-polea",
      "name": "Abducción en polea",
      "pattern": "abduccion",
      "equipment": "polea",
      "default_rest_s": 60,
      "per_side": true,
      "description": "Con una tobillera en la polea baja, separas la pierna lateralmente manteniendo el tronco firme. Una pierna cada vez."
    },
    {
      "id": "caminata-lateral-banda",
      "name": "Caminata lateral con banda",
      "pattern": "abduccion",
      "equipment": "banda",
      "default_rest_s": 45,
      "description": "Con una banda por encima de las rodillas y semiflexionada, caminas de lado manteniendo la tensión. Buena para activar antes de entrenar pierna."
    },
    {
      "id": "prensa-pies-altos",
      "name": "Prensa con pies altos y separados",
      "pattern": "gluteo",
      "equipment": "maquina",
      "default_rest_s": 120,
      "description": "Prensa colocando los pies en la parte alta de la plataforma y más separados de lo normal. Desplaza el trabajo del cuádriceps al glúteo y al isquiotibial, y permite bajar más."
    },
    {
      "id": "step-up-cajon",
      "name": "Subida al cajón",
      "pattern": "gluteo",
      "equipment": "mancuernas",
      "default_rest_s": 90,
      "per_side": true,
      "description": "Subes a un cajon alto con una pierna, sin impulsarte con la de abajo. Cuanto más alto el cajon, más glúteo. Trabaja el glúteo en posición estirada."
    },
    {
      "id": "pull-through-polea",
      "name": "Pull through en polea",
      "pattern": "gluteo",
      "equipment": "polea",
      "default_rest_s": 90,
      "description": "De espaldas a la polea baja, con la cuerda entre las piernas, empujas la cadera hacia atrás y vuelves apretando el glúteo. Ensena el patron de bisagra de cadera sin cargar la espalda."
    },
    {
      "id": "hip-thrust-mancuerna",
      "name": "Hip thrust con mancuerna",
      "pattern": "gluteo",
      "equipment": "mancuernas",
      "default_rest_s": 90,
      "description": "Version del hip thrust con una mancuerna sobre la cadera, para cuando la barra o el banco estan ocupados. Menos carga máxima."
    },
    {
      "id": "prensa-unilateral",
      "name": "Prensa a una pierna",
      "pattern": "cuadriceps",
      "equipment": "maquina",
      "default_rest_s": 90,
      "per_side": true,
      "description": "Prensa empujando con una sola pierna. Corrige descompensaciones y permite más recorrido."
    },
    {
      "id": "elevaciones-laterales-maquina",
      "name": "Elevaciones laterales en máquina",
      "pattern": "deltoides_lateral",
      "equipment": "maquina",
      "default_rest_s": 60,
      "description": "Version guiada de las elevaciones laterales. Mantiene tensión constante y evita el impulso."
    },
    {
      "id": "gemelos-sentado",
      "name": "Gemelos sentado",
      "pattern": "gemelo",
      "equipment": "maquina",
      "default_rest_s": 60,
      "description": "Elevacion de talón sentada, con las rodillas flexionadas. Enfatiza el soleo, el musculo profundo de la pantorrilla."
    },
    {
      "id": "gemelos-en-prensa",
      "name": "Gemelos en prensa",
      "pattern": "gemelo",
      "equipment": "maquina",
      "default_rest_s": 60,
      "description": "Con las puntas de los pies en el borde de la plataforma de la prensa, empujas estirando el tobillo."
    }
  ],
